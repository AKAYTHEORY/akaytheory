# Environment Configuration for AkayTheory
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/akaytheory_dev?schema=public"

# Authentication & Sessions
SESSION_SECRET="akaytheory-dev-super-secure-session-secret-key-32chars"
SESSION_COOKIE_NAME="akaytheory_session"
SESSION_TTL_DAYS=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Logging
LOG_LEVEL=debug

