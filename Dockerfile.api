# ==============================================================================
# Production Hardened Multi-Stage Dockerfile for AkayTheory API
# Based on refs/INFRASTRUCTURE production engineering patterns:
# - Multi-stage build minimizing attack surface
# - Rootless user execution (non-root UID 10001)
# - Process signal management via dumb-init (zombie reaping & graceful SIGTERM)
# - Container healthcheck command
# ==============================================================================

FROM node:20-alpine AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma
COPY packages ./packages
COPY apps/api ./apps/api

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @akaytheory/api db:generate
RUN pnpm --filter @akaytheory/api build

# ------------------------------------------------------------------------------
FROM node:20-alpine AS runner
WORKDIR /app
RUN apk add --no-cache dumb-init

ENV NODE_ENV=production
RUN addgroup -g 10001 -S akaygroup && \
    adduser -u 10001 -S akayuser -G akaygroup

COPY --chown=akayuser:akaygroup --from=builder /app/node_modules ./node_modules
COPY --chown=akayuser:akaygroup --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --chown=akayuser:akaygroup --from=builder /app/packages/visualizations/dist ./packages/visualizations/dist
COPY --chown=akayuser:akaygroup --from=builder /app/apps/api/dist ./apps/api/dist
COPY --chown=akayuser:akaygroup --from=builder /app/prisma ./prisma

USER 10001:10001
EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4000/health || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "apps/api/dist/server.js"]

