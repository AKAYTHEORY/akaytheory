{
  "name": "akaytheory-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AkayTheory — Interactive Computer Science and Software Engineering Learning Platform",
  "scripts": {
    "dev": "pnpm --parallel --filter @akaytheory/* dev",
    "dev:api": "pnpm --filter @akaytheory/api dev",
    "dev:web": "pnpm --filter @akaytheory/web dev",
    "build": "pnpm --recursive --topological --filter @akaytheory/* build",
    "type-check": "pnpm build && pnpm --recursive --filter @akaytheory/* type-check",
    "test": "pnpm --recursive --filter @akaytheory/* test",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:migrate": "pnpm --filter @akaytheory/api db:migrate",
    "db:generate": "pnpm --filter @akaytheory/api db:generate",
    "db:seed": "pnpm --filter @akaytheory/api db:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "bcrypt": "^6.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  }
}
