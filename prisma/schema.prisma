datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  LEARNER
  CONTENT_AUTHOR
  CONTENT_REVIEWER
  CONTENT_PUBLISHER
  CONTENT_ADMINISTRATOR
  SYSTEM_ADMINISTRATOR
}

enum TopicStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum MasteryLevel {
  NOT_STARTED
  ATTEMPTED
  FAMILIAR
  PROFICIENT
  MASTERED
}

enum RevisionStatus {
  UPCOMING
  DUE
  OVERDUE
}

enum RoadmapNodeState {
  PREREQUISITE_NOT_MET
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVISION
  MASTERED
}

enum RoadmapNodeType {
  CATEGORY
  TOPIC
  SUBTOPIC
  PROBLEM
  ASSESSMENT
  MILESTONE
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  SELF_REPORTED_SOLVED
  VERIFIED_PASSED
  ATTEMPTED
}

// -------------------------------------------------------------
// 1. IDENTITY & ACCESS (DATA-ENT-001 to 004)
// -------------------------------------------------------------

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  username        String      @unique
  displayName     String
  avatarUrl       String?
  role            UserRole    @default(LEARNER)
  isEmailVerified Boolean     @default(false)
  passwordHash    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  accounts            Account[]
  sessions            Session[]
  userProgress        UserProgress[]
  masteryAssessments  MasteryAssessment[]
  bookmarks           Bookmark[]
  notes               Note[]
  submissions         Submission[]
  notifications       Notification[]
  revisionSchedules   RevisionSchedule[]
  userPreference      UserPreference?
  learningActivities  LearningActivity[]
  auditLogs           AuditLog[]
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String   // e.g. "google", "credentials"
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  permissions String[] // Array of permission strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -------------------------------------------------------------
// 2. CURRICULUM & KNOWLEDGE GRAPH (DATA-ENT-005 to 009)
// -------------------------------------------------------------

model Domain {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  orderIndex  Int
  iconName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories Category[]
}

model Category {
  id          String   @id @default(uuid())
  domainId    String
  slug        String   @unique
  title       String
  description String
  orderIndex  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain Domain  @relation(fields: [domainId], references: [id], onDelete: Restrict)
  topics Topic[]
}

model Topic {
  id               String      @id @default(uuid())
  categoryId       String
  slug             String      @unique
  title            String
  description      String
  status           TopicStatus @default(DRAFT)
  isArchived       Boolean     @default(false)
  orderIndex       Int
  estimatedMinutes Int         @default(30)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Topological and referential safety (BR-019 / DATA-CON-011)
  dependenciesAsPrereq TopicDependency[]   @relation("PrereqTopic")
  dependenciesAsDep    TopicDependency[]   @relation("DependentTopic")
  sourceCrossLinks     CrossDomainLink[]   @relation("SourceTopic")
  targetCrossLinks     CrossDomainLink[]   @relation("TargetTopic")
  lessons              Lesson[]
  problems             Problem[]
  userProgress         UserProgress[]
  masteryAssessments   MasteryAssessment[]
  revisionSchedules    RevisionSchedule[]
  roadmapNodes         RoadmapNode[]

  @@index([categoryId])
  @@index([isArchived, orderIndex])
}

model TopicDependency {
  id                   String   @id @default(uuid())
  prerequisiteTopicId String
  dependentTopicId     String
  relationshipType     String   @default("DIRECT_PREREQUISITE")
  createdAt            DateTime @default(now())

  prerequisiteTopic Topic @relation("PrereqTopic", fields: [prerequisiteTopicId], references: [id], onDelete: Restrict)
  dependentTopic    Topic @relation("DependentTopic", fields: [dependentTopicId], references: [id], onDelete: Restrict)

  @@unique([prerequisiteTopicId, dependentTopicId])
}

model CrossDomainLink {
  id               String   @id @default(uuid())
  sourceTopicId    String
  targetTopicId    String
  relationshipType String
  description      String?
  createdAt        DateTime @default(now())

  sourceTopic Topic @relation("SourceTopic", fields: [sourceTopicId], references: [id], onDelete: Restrict)
  targetTopic Topic @relation("TargetTopic", fields: [targetTopicId], references: [id], onDelete: Restrict)

  @@unique([sourceTopicId, targetTopicId])
}

// -------------------------------------------------------------
// 3. ROADMAPS (DATA-ENT-010 to 012)
// -------------------------------------------------------------

model Roadmap {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  domainId    String?
  isMaster    Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nodes RoadmapNode[]
  edges RoadmapEdge[]
}

model RoadmapNode {
  id         String          @id @default(uuid())
  roadmapId  String
  topicId    String?
  nodeType   RoadmapNodeType
  title      String
  positionX  Float
  positionY  Float
  orderIndex Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  roadmap      Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topic        Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sourceEdges  RoadmapEdge[] @relation("SourceNode")
  targetEdges  RoadmapEdge[] @relation("TargetNode")

  @@index([roadmapId, orderIndex])
}

model RoadmapEdge {
  id           String   @id @default(uuid())
  roadmapId    String
  sourceNodeId String
  targetNodeId String
  edgeType     String   @default("REQUIRED")
  createdAt    DateTime @default(now())

  roadmap    Roadmap     @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  sourceNode RoadmapNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode RoadmapNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId])
}

// -------------------------------------------------------------
// 4. LESSONS & VISUALIZATIONS (DATA-ENT-013 to 016)
// -------------------------------------------------------------

model Lesson {
  id          String        @id @default(uuid())
  topicId     String
  slug        String        @unique
  title       String
  version     Int           @default(1)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  topic     Topic           @relation(fields: [topicId], references: [id], onDelete: Restrict)
  sections  LessonSection[]
  questions Question[]

  @@index([topicId, status])
}

model LessonSection {
  id                     String            @id @default(uuid())
  lessonId               String
  sectionType            String
  title                  String
  contentMarkdown        String
  orderIndex             Int
  visualizationConfigId String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  lesson               Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  visualizationConfig VisualizationConfig? @relation(fields: [visualizationConfigId], references: [id], onDelete: SetNull)

  @@index([lessonId, orderIndex])
}

model LessonTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  layoutJson  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VisualizationConfig {
  id             String   @id @default(uuid())
  visualizerType String
  initialData    Json
  stepRules      Json
  themeConfig    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sections LessonSection[]
}

// -------------------------------------------------------------
// 5. PROBLEM LIBRARY (DATA-ENT-017 to 019)
// -------------------------------------------------------------

model Problem {
  id                String            @id @default(uuid())
  topicId           String
  slug              String            @unique
  title             String
  difficulty        ProblemDifficulty @default(EASY)
  statementMarkdown String
  examplesJson      Json
  constraintsJson   Json
  hintsJson         Json
  solutionMarkdown  String?
  timeComplexity    String
  spaceComplexity   String
  externalUrl       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  topic       Topic          @relation(fields: [topicId], references: [id], onDelete: Restrict)
  problemTags ProblemToTag[]
  submissions Submission[]
}

model ProblemTag {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  problems ProblemToTag[]
}

model ProblemToTag {
  problemId String
  tagId     String

  problem Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag     ProblemTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
}

// -------------------------------------------------------------
// 6. ASSESSMENTS & MASTERY (DATA-ENT-020 to 023)
// -------------------------------------------------------------

model Question {
  id             String   @id @default(uuid())
  lessonId       String
  promptMarkdown String
  explanation    String
  orderIndex     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lesson  Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options QuizOption[]

  @@index([lessonId, orderIndex])
}

model QuizOption {
  id          String   @id @default(uuid())
  questionId  String
  text        String
  isCorrect   Boolean  @default(false)
  orderIndex  Int
  createdAt   DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model UserProgress {
  id                   String       @id @default(uuid())
  userId               String
  topicId              String
  masteryLevel         MasteryLevel @default(NOT_STARTED)
  consecutivePassCount Int          @default(0)
  lastStudiedAt        DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@unique([userId, topicId])
  @@index([userId, lastStudiedAt])
  @@index([masteryLevel])
}

model MasteryAssessment {
  id           String   @id @default(uuid())
  userId       String
  topicId      String
  evidenceType String
  score        Float
  passed       Boolean
  metadataJson Json?
  createdAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Restrict)
}

// -------------------------------------------------------------
// 7. LEARNER WORKSPACE (DATA-ENT-024 to 026)
// -------------------------------------------------------------

model Bookmark {
  id           String   @id @default(uuid())
  userId       String
  resourceType String   // "TOPIC", "LESSON", "PROBLEM"
  resourceId   String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, resourceId])
}

model Note {
  id              String   @id @default(uuid())
  userId          String
  resourceType    String   // "TOPIC", "LESSON", "PROBLEM"
  resourceId      String
  contentMarkdown String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Submission {
  id               String           @id @default(uuid())
  userId           String
  problemId        String
  status           SubmissionStatus @default(ATTEMPTED)
  solutionLanguage String?
  userCode         String?
  notes            String?
  createdAt        DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
}

// -------------------------------------------------------------
// 8. OPERATIONS & CADENCE (DATA-ENT-027 to 034)
// -------------------------------------------------------------

model DailyChallenge {
  id          String   @id @default(uuid())
  date        DateTime @unique // Normalized to UTC midnight
  topicId     String
  title       String
  description String
  createdAt   DateTime @default(now())
}

model MediaAsset {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  url       String
  sizeBytes Int
  createdAt DateTime @default(now())
}

model ContentPublication {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  version     Int
  publishedBy String
  publishedAt DateTime @default(now())
}

model LearningActivity {
  id           String   @id @default(uuid())
  userId       String?
  activityType String
  metadataJson Json?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model UserPreference {
  id                         String   @id @default(uuid())
  userId                     String   @unique
  theme                      String   @default("dark")
  explanationDepth           String   @default("standard")
  codeLanguage               String   @default("typescript")
  dailyGoalMinutes           Int      @default(30)
  emailNotificationsEnabled Boolean  @default(true)
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  ipAddress String?
  details   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RevisionSchedule {
  id             String         @id @default(uuid())
  userId         String
  topicId        String
  revisionStatus RevisionStatus @default(UPCOMING)
  intervalDays   Int            @default(3)
  dueAt          DateTime       // Normalized to 00:00:00 UTC
  lastReviewedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@unique([userId, topicId]) // DATA-CON-010: Exactly one revision schedule per user-topic
  @@index([userId, dueAt])
  @@index([dueAt])
}

